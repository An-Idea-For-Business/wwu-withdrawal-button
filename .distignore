# Files and folders excluded from the distributed plugin ZIP.
# The build script (bin/build.sh) packages everything EXCEPT these.

/_internal
/docs
/tests
/.github
/bin
/node_modules
/build
/dist
/.git
.gitignore
.gitattributes
.distignore
composer.lock
phpcs.xml.dist
*.dist
crowdin.yml
CONTRIBUTING.md
CODE_OF_CONDUCT.md
SECURITY.md
MASTER-wwu-wb.md
.editorconfig

# Editor / AI-assistant config (internal dev notes — never ship in the ZIP).
# NOTE: the build script filters by THIS file only, not by .gitignore, so an
# untracked editor file present on disk would otherwise be packaged.
.cursorrules
/.cursor
